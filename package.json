{
  "name": "web-performance-benchmarker",
  "version": "1.0.0",
  "description": "Web Performance Benchmarking Platform - Analyze performance, accessibility, SEO, and Core Web Vitals",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "dev:backend": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.45.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "uuid": "^10.0.0",
    "vite": "^5.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}
